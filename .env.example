# ---------------------------------------------------------------------------
# UPI Verify — example configuration.  Copy to .env for local development.
# NEVER commit a real .env.  All values below are placeholders.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
# Public origin of this deployment. Used for OAuth redirects, webhook URLs,
# absolute links and CSRF origin checks. Must be https:// in production.
APP_URL=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info

# Database (PostgreSQL 14+). Use sslmode=require in managed production databases.
DATABASE_URL=postgresql://app:app@127.0.0.1:55432/payment_gateway
PGSSLMODE=disable
DB_POOL_MAX=10

# Sessions / crypto. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-me-with-48-random-bytes-base64
# Token encryption keys, comma separated, newest first: v1:<base64 32 bytes>
#   node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
# Rotate by prepending a new key; old keys remain for decryption.
TOKEN_ENCRYPTION_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
COOKIE_SECURE=false

# Amount and policy defaults
MAX_ORDER_AMOUNT_PAISE=10000000
DEFAULT_ORDER_EXPIRY_MINUTES=15
MATCHING_WINDOW_MINUTES=180
RECONCILIATION_INTERVAL_SECONDS=120
# Run the reconciliation scheduler inside the web process. For production you
# normally run `npm run worker` as a separate service instead.
RUN_BACKGROUND_JOBS=false

# ---------------------------------------------------------------------------
# Providers. Leave blank to disable. Only enable providers you have onboarded.
# ---------------------------------------------------------------------------
# Razorpay: Dashboard -> Account & Settings -> API Keys / Webhooks
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Cashfree: Dashboard -> Developers -> API Keys / Webhooks
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_MODE=sandbox

# Sandbox provider is a deterministic TEST DOUBLE. It never moves money and
# MUST remain false outside local development / automated tests.
ALLOW_SANDBOX_PROVIDER=false

# ---------------------------------------------------------------------------
# Google / Gmail (optional supplementary verification)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Enable the Gmail API. Scope requested: gmail.readonly (restricted scope).
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# Optional Pub/Sub topic for push notifications (users.watch). Polling is the default.
GOOGLE_PUBSUB_TOPIC=
GMAIL_POLL_INTERVAL_SECONDS=300
# Comma separated sender domains accepted as transaction alerts, e.g.
# hdfcbank.net,icicibank.com,axisbank.com,alerts.razorpay.com
# Empty list disables monitoring: the platform never guesses which senders to trust.
GMAIL_ALLOWED_SENDER_DOMAINS=

# Data retention (days)
RETENTION_PAYMENT_EVENTS_DAYS=180
RETENTION_AUDIT_LOGS_DAYS=730
